# Application
APP_NAME=clauseguard
DEBUG=false
ENVIRONMENT=development           # set to "production" when deployed (enforces explicit CORS_ORIGINS)

# --- Security ---
# Optional shared key. When set, all /api/v1 routes except /health require an `X-API-Key` header.
# Leave empty for local development. NOTE: a key shipped in a browser bundle is visible to anyone;
# it blocks casual scripts but is not a substitute for the per-IP quotas below.
API_KEY=
# Comma-separated browser origins allowed by CORS (no "*" in production).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Number of trusted reverse proxies in front of the API (Render/Railway = 1). Keep 0 when exposed directly.
TRUSTED_PROXY_HOPS=0

# Per-IP quotas on endpoints that spend LLM tokens (fixed window).
QUOTA_ENABLED=true
QUOTA_WINDOW_S=3600
QUOTA_UPLOADS=5
QUOTA_EXTRACTIONS=10
QUOTA_QUESTIONS=40

# Database (PostgreSQL with pgvector)
# Used by docker compose to create/connect the local container. Use letters and digits only.
POSTGRES_PASSWORD=change-me-locally
DATABASE_URL=postgresql+asyncpg://clauseguard:change-me-locally@localhost:5434/clauseguard
DATABASE_SYNC_URL=postgresql+psycopg2://clauseguard:change-me-locally@localhost:5434/clauseguard

# Redis
REDIS_URL=redis://localhost:6379/0

# --- Primary Provider: Google Gemini via Google AI Studio (FreeLLM.net) ---
# Sign up at https://aistudio.google.com/app/apikey (No credit card required, 1M context)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_ID=gemini-flash-lite-latest
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# --- Fallback Provider: Groq (FreeLLM.net) ---
# Sign up at https://console.groq.com/keys (No credit card required, ultra-low latency)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL_ID=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Embeddings
EMBEDDING_DIMENSION=384

# Resilience
LLM_MAX_RETRIES=3
LLM_BASE_DELAY_S=1.0
LLM_MAX_DELAY_S=15.0
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_S=30.0
RATE_LIMIT_TOKENS=100
RATE_LIMIT_REFILL_RATE=10.0

# Pipeline
CHUNK_SIZE=512
CHUNK_OVERLAP=64
CONTEXT_TOKEN_BUDGET=6000
RETRIEVAL_TOP_K=5
EXTRACTION_CONCURRENCY_CAP=4
MAX_REPAIR_ATTEMPTS=2
CITATION_SIMILARITY_THRESHOLD=0.80

# Observability (Langfuse Tracing & Prometheus Metrics)
ENABLE_METRICS=true
LANGFUSE_HOST=https://jp.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=pk-lf-your_public_key_here
LANGFUSE_SECRET_KEY=sk-lf-your_secret_key_here
