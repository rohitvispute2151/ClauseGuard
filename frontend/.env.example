# Local dev: leave VITE_API_BASE_URL unset; Vite proxies /api to VITE_BACKEND_URL.
# VITE_BACKEND_URL=http://127.0.0.1:8000

# Production (set in the Vercel project settings, then redeploy -- Vite inlines these at build time):
# VITE_API_BASE_URL=https://clauseguard-api.onrender.com/api/v1
# VITE_API_KEY=            # only if the backend sets API_KEY
